# Copy to .env for local development (server/.env is gitignored).
# In production these are set in the Render dashboard (see render.yaml).

# Your MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net)
MONGODB_URI=

# Database name (defaults to "bball")
MONGODB_DB=bball

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=https://bball.fun,https://www.bball.fun

PORT=4000
